# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://talent_user:talent_pass@localhost:5432/talent_ai

# ── JWT Authentication ────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE-ME-to-a-random-256-bit-secret

# ── Google OAuth ──────────────────────────────────────────────────────────
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── OpenRouter API (required for RAG resume evaluation) ───────────────────
OPENROUTER_API_KEY=your-openrouter-api-key

# ── OpenRouter API for Chatbot (can be same or different key) ─────────────
OPENROUTER_API_KEY_CHAT=your-openrouter-api-key-for-chatbot

# ── Optional: Google AI fallback (if OpenRouter keys are not set) ─────────
# GOOGLE_API_KEY=your-google-ai-api-key

# ── Optional: override model names ───────────────────────────────────────
# EMBEDDING_MODEL=openai/text-embedding-3-small
# LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
